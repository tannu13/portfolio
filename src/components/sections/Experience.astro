---
import Section from '../templates/Section.astro';
import ExperienceEntry from '../organisms/ExperienceEntry.astro';
import CareerTrace from '../organisms/CareerTrace.astro';
import Disclosure from '../molecules/Disclosure.astro';
import Reveal from '../atoms/Reveal.astro';
import { roles, axisTicks, careerSegments, periodOf } from '../../data/experience';
---

<Section
  id="experience"
  eyebrow="Experience"
  title="Where the work happened"
  lede="Seven and a half years across three companies, read as one trace. The timeline stays with you through the section, so it is always clear which part of the run you are reading."
  tone="raised"
>
  <div class="xp-list">
    <CareerTrace segments={careerSegments} ticks={axisTicks} />

    {
      roles.map((role, i) => (
        <Reveal delay={i * 60}>
          <ExperienceEntry
            id={role.id}
            company={role.company}
            role={role.role}
            location={role.location}
            period={periodOf(role)}
            stories={role.stories}
            metric={role.metric}
          >
            {role.detail && (
              <Disclosure summary="More from this role" tone="quiet">
                <div class="xp-detail">
                  {role.detail.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </Disclosure>
            )}
          </ExperienceEntry>
        </Reveal>
      ))
    }
  </div>
</Section>

<style>
  .xp-list { display: flex; flex-direction: column; }

  .xp-detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--measure);
    color: var(--text-secondary);
    line-height: var(--lh-prose);
  }
</style>
