---
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import Reveal from '../atoms/Reveal.astro';
import ArchitectureDiagram from '../organisms/ArchitectureDiagram.astro';
import { site, heroFlow } from '../../data/site';

/**
 * Hero — name, what I do, and the shape every system on this page has
 * in common, drawn in the same language the project diagrams use.
 */
---

<section class="hero" id="home">
  <div class="hero__inner u-container">
    <div class="hero__text">
      <Reveal>
        <h1 class="hero__name">{site.name}</h1>
      </Reveal>

      <Reveal delay={60}>
        <p class="hero__title u-label">{site.title}</p>
      </Reveal>

      <Reveal delay={120}>
        <p class="hero__lede">{site.positioning}</p>
      </Reveal>

      <Reveal delay={180} class="hero__actions">
        <Button href="#projects" variant="primary" icon="arrow-down">View projects</Button>
        <Button href={site.resumeUrl} variant="secondary" icon="download">Resume</Button>
      </Reveal>

      <Reveal delay={240} class="hero__links">
        <a class="hero__link" href={site.githubUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="github" size={15} /><span class="u-label">GitHub</span>
        </a>
        <a class="hero__link" href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">
          <Icon name="linkedin" size={15} /><span class="u-label">LinkedIn</span>
        </a>
        <a class="hero__link" href={`mailto:${site.email}`}>
          <Icon name="mail" size={15} /><span class="u-label">Email</span>
        </a>
      </Reveal>
    </div>

    <Reveal variant="scale" delay={160} class="hero__visual">
      <ArchitectureDiagram
        stages={heroFlow.stages}
        edges={heroFlow.edges}
        legend={false}
        class="hero__diagram"
      />
      <p class="hero__caption">
        <span class="u-label">The shape of the work</span>
        Something happens, it is written down once, something reads it, and the result
        is kept. Both projects below are variations on this.
      </p>
    </Reveal>
  </div>
</section>

<style>
  .hero { padding-block: clamp(3rem, 2rem + 6vw, 6.5rem) 0; }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__text { display: flex; flex-direction: column; gap: var(--space-4); }

  .hero__name {
    font-size: var(--fs-display);
    line-height: var(--lh-display);
    letter-spacing: var(--tr-display);
    font-weight: var(--wt-bold);
  }

  .hero__title { color: var(--signal); }

  .hero__lede {
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: var(--lh-prose);
    color: var(--text-secondary);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-standard);
  }

  .hero__link:hover { color: var(--text-primary); }

  /* The hero diagram is the same component as a project diagram, run
     at a smaller size — the language is introduced here and reused
     unchanged further down the page. */
  .hero__visual :global(.hero__diagram) {
    --node-min: 5.5rem;
    --node-pad: var(--space-2);
    --arch-gap: var(--space-5);
  }

  .hero__caption {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-4);
    max-width: 46ch;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--text-muted);
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: var(--space-9);
    }
  }
</style>
