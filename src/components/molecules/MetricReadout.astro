---
/**
 * MetricReadout — an instrument readout for a single measured result.
 * Numbers are set in the mono at full width so they line up in columns.
 */
interface Props {
  value: string;
  unit?: string;
  label: string;
  note?: string;
  tone?: 'default' | 'signal';
  size?: 'md' | 'sm';
  class?: string;
}

const {
  value,
  unit,
  label,
  note,
  tone = 'default',
  size = 'md',
  class: className,
} = Astro.props;
---

<div class:list={['metric', `metric--${tone}`, `metric--${size}`, className]}>
  <div class="metric__value u-data">
    {value}{unit && <span class="metric__unit">{unit}</span>}
  </div>
  <div class="metric__label u-label">{label}</div>
  {note && <p class="metric__note">{note}</p>}
</div>

<style>
  .metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: var(--hairline) solid var(--border-strong);
  }

  .metric__value {
    font-size: var(--metric-size, clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem));
    font-weight: var(--wt-semi);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .metric--signal .metric__value { color: var(--signal); }

  .metric__unit {
    font-size: 0.5em;
    margin-left: 0.2em;
    color: var(--text-muted);
    letter-spacing: 0;
  }

  .metric--sm { --metric-size: var(--fs-h4); }

  .metric__label { color: var(--text-muted); }

  .metric__note {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
    line-height: var(--lh-normal);
  }
</style>
