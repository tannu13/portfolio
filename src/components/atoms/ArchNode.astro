---
/**
 * ArchNode — one component in an architecture diagram.
 *
 * The diagram language separates two variables so a reader can decode
 * a system at a glance:
 *   shape / border  → what kind of thing this is (kind)
 *   colour          → how data moves through it (set by the edges)
 */
import type { NodeKind } from '../../data/types';

interface Props {
  id: string;
  label: string;
  sub?: string;
  kind?: NodeKind;
  class?: string;
}

const { id, label, sub, kind = 'service', class: className } = Astro.props;
---

<button
  class:list={['node', `node--${kind}`, className]}
  type="button"
  data-node={id}
  data-kind={kind}
  aria-pressed="false"
  aria-label={`${label}${sub ? `, ${sub}` : ''} — hold the highlight on its connections`}
>
  <span class="node__kind u-label">{kind}</span>
  <span class="node__label">{label}</span>
  {sub && <span class="node__sub u-data">{sub}</span>}
</button>

<style>
  .node {
    position: relative;
    z-index: var(--z-diagram-node);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: var(--node-min, 8.25rem);
    padding: var(--node-pad, var(--space-3));
    background-color: var(--surface-raised);
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-sm);
    text-align: left;
    color: inherit;
    cursor: pointer;
    transition:
      border-color var(--dur-2) var(--ease-standard),
      box-shadow var(--dur-2) var(--ease-standard),
      opacity var(--dur-2) var(--ease-standard),
      transform var(--dur-2) var(--ease-standard);
  }

  .node__kind {
    font-size: var(--fs-micro);
    color: var(--text-muted);
    opacity: 0.75;
  }

  .node__label {
    font-size: var(--fs-sm);
    font-weight: var(--wt-semi);
    letter-spacing: var(--tr-heading);
    line-height: 1.2;
  }

  .node__sub {
    font-size: var(--fs-micro);
    color: var(--text-secondary);
  }

  /* --- kind treatments ------------------------------------------ */

  /* client — the only rounded component; it is the human end */
  .node--client { border-radius: var(--r-lg); }

  /* engine — the core. A doubled rule reads as machined housing. */
  .node--engine {
    border-color: var(--text-primary);
    box-shadow: inset 0 0 0 3px var(--surface-raised),
                inset 0 0 0 4px var(--border-hairline);
  }

  /* store — sunken fill and a weighted base, the diagram's floor */
  .node--store {
    background-color: var(--surface-sunken);
    border-bottom-width: 3px;
  }

  /* stream — a ticked leading edge: an ordered log with offsets */
  .node--stream {
    border-left: none;
    padding-left: calc(var(--node-pad, var(--space-3)) + 5px);
  }
  .node--stream::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 3px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--border-contrast) 0 3px,
      transparent 3px 7px
    );
  }

  /* external — dashed: outside the boundary we own */
  .node--external {
    border-style: dashed;
    background-color: transparent;
    color: var(--text-secondary);
  }

  /* --- interaction ---------------------------------------------- */
  .node:hover,
  .node:focus-visible,
  .node[data-active] {
    border-color: var(--signal);
    box-shadow: 0 0 0 1px var(--signal);
  }

  .node[data-related] {
    border-color: var(--flow);
    box-shadow: 0 0 0 1px var(--flow-edge);
  }

  .node[data-dimmed] { opacity: 0.32; }
</style>
