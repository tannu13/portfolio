---
/**
 * Icon — a small, hand-picked set drawn on a 16px grid with 1.5px
 * strokes so icons share the weight of the hairline rules around them.
 */
export type IconName =
  | 'arrow-right' | 'arrow-down' | 'external' | 'download' | 'github'
  | 'linkedin' | 'mail' | 'plus' | 'minus' | 'sun' | 'moon' | 'menu'
  | 'close' | 'check';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  [key: string]: unknown;
}

/* `rest` carries Astro's scope attribute through to the <svg>, so a
   parent component can style the icon it passed in. */
const { name, size = 16, class: className, ...rest } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M2.5 8h11M9.5 4l4 4-4 4"/>',
  'arrow-down': '<path d="M8 2.5v11M4 9.5l4 4 4-4"/>',
  external: '<path d="M6.5 3H3.5A1.5 1.5 0 0 0 2 4.5v8A1.5 1.5 0 0 0 3.5 14h8a1.5 1.5 0 0 0 1.5-1.5V9.5"/><path d="M9.5 2.5H14v4.5M14 2.5 7.5 9"/>',
  download: '<path d="M8 2v8M4.5 7l3.5 3.5L11.5 7M2.5 13.5h11"/>',
  github:
    '<path d="M6 13.2c-3 .9-3-1.5-4.2-1.8m8.4 3.1v-2.4c0-.7.1-1-.3-1.3 2-.2 3.9-1 3.9-4.2a3.3 3.3 0 0 0-.9-2.3 3 3 0 0 0-.1-2.3s-.8-.2-2.5.9a8.6 8.6 0 0 0-4.4 0C4.2 1.8 3.4 2 3.4 2a3 3 0 0 0-.1 2.3 3.3 3.3 0 0 0-.9 2.3c0 3.2 1.9 4 3.9 4.2-.3.3-.3.6-.3 1.1v2.6" stroke-linecap="round" stroke-linejoin="round"/>',
  linkedin:
    '<path d="M4 6.5v7M4 3.4v.1M8 13.5v-4a2.2 2.2 0 0 1 4.4 0v4M8 6.5v7"/>',
  mail: '<rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.5"/><path d="m2.5 4.5 5.5 4 5.5-4"/>',
  plus: '<path d="M8 3.5v9M3.5 8h9"/>',
  minus: '<path d="M3.5 8h9"/>',
  sun: '<circle cx="8" cy="8" r="3.1"/><path d="M8 1.5v1.4M8 13.1v1.4M14.5 8h-1.4M2.9 8H1.5M12.6 3.4l-1 1M4.4 11.6l-1 1M12.6 12.6l-1-1M4.4 4.4l-1-1"/>',
  moon: '<path d="M13.4 9.4A5.6 5.6 0 0 1 6.6 2.6a5.9 5.9 0 1 0 6.8 6.8Z"/>',
  menu: '<path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"/>',
  close: '<path d="M4 4l8 8M12 4l-8 8"/>',
  check: '<path d="m3 8.5 3.5 3.5L13 4.5"/>',
};
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
