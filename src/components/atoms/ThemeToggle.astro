---
import Icon from './Icon.astro';

/**
 * ThemeToggle — a two-position hardware switch. It starts unset, so
 * the system preference wins until the visitor states one; from then
 * on the choice is remembered.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  class:list={['toggle', className]}
  type="button"
  role="switch"
  aria-checked="false"
  aria-label="Dark theme"
  data-theme-toggle
>
  <span class="toggle__track">
    <span class="toggle__thumb">
      <Icon name="sun" size={12} class="toggle__icon toggle__icon--sun" />
      <Icon name="moon" size={12} class="toggle__icon toggle__icon--moon" />
    </span>
  </span>
</button>

<style>
  .toggle {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1);
    border-radius: var(--r-sm);
  }

  .toggle__track {
    position: relative;
    display: block;
    width: 46px;
    height: 24px;
    border: var(--hairline) solid var(--border-strong);
    border-radius: var(--r-sm);
    background-color: var(--surface-sunken);
    /* two detents, so the switch reads as a mechanism with positions */
    background-image: linear-gradient(
      to right,
      transparent 0 22px,
      var(--border-hairline) 22px 23px,
      transparent 23px 100%
    );
    transition: border-color var(--dur-2) var(--ease-standard);
  }

  .toggle:hover .toggle__track { border-color: var(--signal); }

  .toggle__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: var(--r-xs);
    background-color: var(--surface-inverse);
    color: var(--text-inverse);
    transition: transform var(--dur-2) var(--ease-snap);
  }

  .toggle[aria-checked='true'] .toggle__thumb { transform: translateX(22px); }

  .toggle__icon {
    grid-area: 1 / 1;
    transition: opacity var(--dur-2) var(--ease-standard);
  }

  .toggle__icon--moon { opacity: 0; }
  .toggle[aria-checked='true'] .toggle__icon--sun { opacity: 0; }
  .toggle[aria-checked='true'] .toggle__icon--moon { opacity: 1; }
</style>

<script>
  const STORAGE_KEY = 'tp-theme';
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const effective = (): 'light' | 'dark' => {
    const set = root.getAttribute('data-theme');
    if (set === 'light' || set === 'dark') return set;
    return media.matches ? 'dark' : 'light';
  };

  const sync = () => {
    const dark = effective() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((el) => {
      el.setAttribute('aria-checked', String(dark));
      el.setAttribute('aria-label', dark ? 'Light theme' : 'Dark theme');
    });
  };

  const apply = (theme: 'light' | 'dark') => {
    root.setAttribute('data-theme', theme);
    try {
      localStorage.setItem(STORAGE_KEY, theme);
    } catch {
      /* storage unavailable — the choice simply lasts for this visit */
    }
    sync();
  };

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((el) => {
    el.addEventListener('click', () => apply(effective() === 'dark' ? 'light' : 'dark'));
  });

  media.addEventListener('change', () => {
    if (!root.hasAttribute('data-theme')) sync();
  });

  sync();
</script>
