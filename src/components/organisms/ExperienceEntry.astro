---
import MetricReadout from '../molecules/MetricReadout.astro';

/**
 * ExperienceEntry — one span of the career trace, written out.
 *
 * The bar itself lives in CareerTrace, which stays on screen for the
 * whole section; this is the text that belongs to it. Deliberately
 * quieter than a ProjectBlock: hairlines, no fill, no card.
 */
interface Props {
  /** Matches the segment id in CareerTrace, which is how the trace
      knows which part of the timeline is being read. */
  id: string;
  company: string;
  role: string;
  location?: string;
  period: string;
  stories: string[];
  metric?: { value: string; unit?: string; label: string };
  class?: string;
}

const { id, company, role, location, period, stories, metric, class: className } = Astro.props;
---

<article class:list={['xp', className]} data-trace-entry={id}>
  <div class="xp__id">
    <h3 class="xp__company">{company}</h3>
    <p class="xp__role">{role}</p>
    {location && <span class="xp__meta u-label">{location}</span>}
    <span class="xp__period u-data">{period}</span>
    {
      metric && (
        <MetricReadout
          value={metric.value}
          unit={metric.unit}
          label={metric.label}
          tone="signal"
          size="sm"
          class="xp__metric"
        />
      )
    }
  </div>

  <div class="xp__main">
    <ul class="xp__stories">
      {stories.map((story) => <li class="xp__story">{story}</li>)}
    </ul>
    <div class="xp__extra"><slot /></div>
  </div>
</article>

<style>
  .xp {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5) var(--space-7);
    border-top: var(--hairline) solid var(--border-hairline);
  }

  .xp:first-of-type { border-top: none; padding-top: 0; }

  .xp__id {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
  }

  .xp__company {
    font-size: var(--fs-h4);
    font-weight: var(--wt-semi);
    letter-spacing: var(--tr-heading);
  }

  .xp__role { font-size: var(--fs-sm); color: var(--text-secondary); }
  .xp__meta { color: var(--text-muted); }
  .xp__period { font-size: var(--fs-micro); color: var(--text-muted); }

  .xp__metric { width: 100%; }

  .xp__main { display: flex; flex-direction: column; gap: var(--space-4); }

  .xp__stories {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }

  .xp__story {
    position: relative;
    padding-left: var(--space-4);
    color: var(--text-secondary);
    line-height: var(--lh-prose);
  }

  /* a tick, not a bullet — the same mark used on the rulers */
  .xp__story::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: var(--hairline);
    background-color: var(--border-contrast);
  }

  @media (min-width: 52rem) {
    .xp {
      grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
      gap: var(--space-5);
    }

    .xp__id {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }

    .xp__metric { margin-top: var(--space-3); }
  }
</style>
