---
import TagList from '../molecules/TagList.astro';
import LinkRow, { type RowLink } from '../molecules/LinkRow.astro';
import StatusDot from '../atoms/StatusDot.astro';

/**
 * ProjectBlock — a case study, not a card. The architecture sits inside
 * the block (slot: "diagram") and the depth expands underneath it
 * (slot: "deep-dive"), so nothing sends the reader to another page.
 */
interface Props {
  index: string;
  title: string;
  description: string;
  technologies: string[];
  concepts: string[];
  links: RowLink[];
  /** No deployment yet — say so rather than offering a dead link. */
  pending?: boolean;
  class?: string;
}

const {
  index,
  title,
  description,
  technologies,
  concepts,
  links,
  pending = false,
  class: className,
} = Astro.props;
---

<article class:list={['project', className]}>
  <div class="project__head">
    <span class="project__index u-data" aria-hidden="true">{index}</span>
    <div class="project__intro">
      <h3 class="project__title">{title}</h3>
      <p class="project__desc u-measure">{description}</p>
      <div class="project__actions">
        {links.length > 0 && <LinkRow links={links} />}
        {pending && <StatusDot state="planned" label="Live demo pending" />}
      </div>
    </div>
  </div>

  <div class="project__diagram">
    <slot name="diagram" />
  </div>

  <div class="project__meta">
    <TagList label="Stack" items={technologies} />
    <TagList label="Engineering" items={concepts} variant="plain" />
  </div>

  <div class="project__depth">
    <slot name="deep-dive" />
  </div>
</article>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: 2px solid var(--text-primary);
  }

  .project__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  .project__index {
    font-size: var(--fs-h3);
    font-weight: var(--wt-bold);
    color: var(--text-muted);
    line-height: 1;
  }

  .project__intro { display: flex; flex-direction: column; gap: var(--space-4); }

  .project__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .project__title {
    font-size: var(--fs-h2);
    text-wrap: balance;
  }

  .project__desc {
    font-size: var(--fs-lead);
    line-height: var(--lh-prose);
    color: var(--text-secondary);
  }

  .project__meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 52rem) {
    .project__head { grid-template-columns: 4rem 1fr; gap: var(--space-5); }
    .project__index { padding-top: 0.55rem; }
    .project__meta { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-7); }
  }
</style>
