<script>
  /* Design-system only: replays an animation that otherwise plays once,
     so the sequence can be inspected without reloading. */
  document.querySelector('[data-replay-reveal]')?.addEventListener('click', () => {
    const scope = document.querySelector('[data-reveal-demo]');
    const items = scope?.querySelectorAll('[data-reveal]') ?? [];
    items.forEach((el) => el.removeAttribute('data-revealed'));
    requestAnimationFrame(() =>
      requestAnimationFrame(() =>
        items.forEach((el) => el.setAttribute('data-revealed', ''))
      )
    );
  });

  document.querySelector('[data-replay-arch]')?.addEventListener('click', (event) => {
    const spec = (event.currentTarget as HTMLElement).closest('section');
    const arch = spec?.querySelector('[data-arch]');
    if (!arch) return;
    arch.removeAttribute('data-drawn');
    arch.removeAttribute('data-flow');
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        arch.setAttribute('data-drawn', '');
        window.setTimeout(() => arch.setAttribute('data-flow', ''), 1150);
      })
    );
  });
</script>
